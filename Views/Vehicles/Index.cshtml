@model List<GarageAI.Models.Vehicle>

@{
    ViewData["Title"] = "Quản lý xe";
}

<h2>🚗 Quản lý xe ô tô</h2>
<p class="text-muted">
    Thêm, tìm kiếm và quản lý phương tiện khách hàng.
</p>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="card p-3 mb-3">
    <h5>Thêm xe mới</h5>

    <form asp-controller="Vehicles"
          asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()

        <div class="row g-2">
            <div class="col-md-3">
                <input name="LicensePlate"
                       class="form-control"
                       placeholder="Biển số xe"
                       maxlength="20"
                       required />
            </div>

            <div class="col-md-3">
                <input name="Brand"
                       class="form-control"
                       placeholder="Hãng xe"
                       required />
            </div>

            <div class="col-md-3">
                <input name="Model"
                       class="form-control"
                       placeholder="Dòng xe"
                       required />
            </div>

            <div class="col-md-3">
                <input name="Year"
                       type="number"
                       min="1886"
                       max="2100"
                       class="form-control"
                       placeholder="Năm sản xuất" />
            </div>

            <div class="col-md-6">
                <select name="CustomerId"
                        asp-items="ViewBag.Customers"
                        class="form-select"
                        required>
                    <option value="">
                        -- Chọn khách hàng --
                    </option>
                </select>
            </div>

            <div class="col-md-6">
                <button type="submit"
                        class="btn btn-primary w-100">
                    Thêm xe
                </button>
            </div>
        </div>
    </form>
</div>

<form method="get" class="d-flex gap-2 mb-3">
    <input name="search"
           value="@ViewBag.Search"
           class="form-control"
           placeholder="Tìm biển số, hãng hoặc dòng xe" />

    <button class="btn btn-outline-primary">
        Tìm kiếm
    </button>
</form>

<div class="card p-3">
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Biển số</th>
                    <th>Hãng</th>
                    <th>Dòng xe</th>
                    <th>Năm</th>
                    <th>Chủ xe</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var v in Model)
                {
                    <tr>
                        <td>@v.Id</td>
                        <td>@v.LicensePlate</td>
                        <td>@v.Brand</td>
                        <td>@v.Model</td>
                        <td>@v.Year</td>
                        <td>@v.Customer?.FullName</td>
                        <td>
                            <a asp-action="Edit"
                               asp-route-id="@v.Id"
                               class="btn btn-sm btn-warning">
                                Sửa
                            </a>

                            <form asp-action="Delete"
                                  asp-route-id="@v.Id"
                                  method="post"
                                  class="d-inline"
                                  onsubmit="return confirm('Bạn chắc chắn muốn xóa xe?')">
                                @Html.AntiForgeryToken()
                                <button type="submit"
                                        class="btn btn-sm btn-danger">
                                    Xóa
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
