@model List<Customer>
<h1>Quản lý khách hàng</h1><p class="text-secondary">Thêm, tìm kiếm và xóa khách hàng (bản khởi đầu).</p>
@if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
<div class="card p-4 mb-4"><h5>Thêm khách hàng</h5><form asp-action="Create" method="post" class="row g-2"><div class="col-md-3"><input name="FullName" required maxlength="120" class="form-control" placeholder="Họ và tên"/></div><div class="col-md-3"><input name="Phone" required class="form-control" placeholder="Số điện thoại"/></div><div class="col-md-3"><input name="Email" type="email" class="form-control" placeholder="Email"/></div><div class="col-md-3"><button class="btn btn-primary w-100">Thêm khách hàng</button></div></form></div>
<form method="get" class="d-flex gap-2 mb-3"><input class="form-control" name="q" value="@ViewBag.Query" placeholder="Tìm theo tên hoặc số điện thoại"/><button class="btn btn-outline-primary">Tìm</button></form>
<div class="card p-3"><table class="table table-hover"><thead><tr><th>ID</th><th>Họ tên</th><th>Số điện thoại</th><th>Email</th><th></th></tr></thead><tbody>@foreach(var item in Model){<tr><td>@item.Id</td><td>@item.FullName</td><td>@item.Phone</td><td>@item.Email</td><td><form asp-action="Delete" method="post" onsubmit="return confirm('Xóa khách hàng này?')"><input type="hidden" name="id" value="@item.Id"/><button class="btn btn-sm btn-outline-danger">Xóa</button></form></td></tr>}</tbody></table></div>
