
@model List<GarageAI.Models.RepairOrderPart>

@{
    ViewData["Title"] = "Phụ tùng phiếu sửa chữa";
    var order = (GarageAI.Models.RepairOrder)ViewBag.Order;
    var availableParts =
        (List<GarageAI.Models.Part>)ViewBag.AvailableParts;
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}


<h2>Quản lý phụ tùng phiếu sửa chữa #@order.Id</h2>

<p>
    <strong>Biển số xe:</strong>
    @order.Vehicle?.LicensePlate
</p>

<div class="card p-3 mb-3">
    <h5>Danh sách phụ tùng đã thêm</h5>

    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Mã phụ tùng</th>
                <th>Tên phụ tùng</th>
                <th>Số lượng</th>
                <th>Đơn giá</th>
                <th>Thành tiền</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            
@foreach (var item in Model)
{
    <tr>
        <td>@item.Part?.Code</td>
        <td>@item.Part?.Name</td>
        <td>@item.Quantity</td>
        <td>@item.UnitPrice.ToString("N0") VNĐ</td>
        <td>@((item.Quantity * item.UnitPrice).ToString("N0")) VNĐ</td>
        <td>
            @if (order.Status != "HoanThanh" &&
                 order.Status != "DaHuy")
            {
                <form asp-controller="RepairOrders"
                      asp-action="RemovePart"
                      method="post"
                      onsubmit="return confirm('Bạn có chắc muốn xóa phụ tùng này?');">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="id"
                           value="@item.Id" />

                    <button type="submit"
                            class="btn btn-danger btn-sm">
                        Xóa
                    </button>
                </form>
            }
        </td>
    </tr>
}

        </tbody>
    </table>

    <h5>
        Tổng tiền:
        @Model.Sum(x => x.Quantity * x.UnitPrice).ToString("N0") VNĐ
    </h5>
</div>

<div class="card p-3">
    <h5>Danh mục phụ tùng hiện có</h5>

    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Mã</th>
                <th>Tên phụ tùng</th>
                <th>Đơn giá</th>
                <th>Tồn kho</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var part in availableParts)
            {
                <tr>
                    <td>@part.Code</td>
                    <td>@part.Name</td>
                    <td>@part.Price.ToString("N0") VNĐ</td>
                    <td>@part.StockQuantity</td>
                    <td>
                    
<td>
    @if (order.Status != "HoanThanh" &&
         order.Status != "DaHuy" &&
         part.StockQuantity > 0)
    {
        <form asp-controller="RepairOrders"
              asp-action="AddPart"
              method="post"
              class="d-flex gap-2">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="repairOrderId"
                   value="@order.Id" />

            <input type="hidden"
                   name="partId"
                   value="@part.Id" />

            <input type="number"
                   name="quantity"
                   value="1"
                   min="1"
                   max="@part.StockQuantity"
                   required
                   class="form-control"
                   style="width:90px" />

            <button type="submit"
                    class="btn btn-success btn-sm">
                Thêm vào phiếu
            </button>
        </form>
    }
    else
    {
        <span class="text-muted">
            Không thể thêm
        </span>
    }
</td>

                </tr>
            }
        </tbody>
    </table>
</div>

<a asp-controller="RepairOrders"
   asp-action="Index"
   class="btn btn-secondary mt-3">
    Quay lại
</a>
