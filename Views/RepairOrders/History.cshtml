
@model List<GarageAI.Models.RepairOrder>
@{
    ViewData["Title"] = "Lịch sử sửa chữa";
    var vehicle = ViewBag.Vehicle as GarageAI.Models.Vehicle;
}

<h2>📋 Lịch sử sửa chữa xe</h2>

@if (vehicle != null)
{
    <form asp-controller="RepairOrders"
          asp-action="AiSummary"
          method="post"
          class="mb-3">
        @Html.AntiForgeryToken()

        <input type="hidden"
               name="vehicleId"
               value="@vehicle.Id" />

        <button type="submit" class="btn btn-primary">
            ✨ AI tóm tắt lịch sử sửa chữa
        </button>
    </form>
}

@if (TempData["AiError"] != null)
{
    <div class="alert alert-warning">
        @TempData["AiError"]
    </div>
}

@if (TempData["AiSummary"] != null)
{
    <div class="card p-3 mb-3">
        <h5>✨ Kết quả tóm tắt từ Gemini AI</h5>

@{
    var aiSummary = TempData["AiSummary"]?.ToString() ?? "";
}

<div class="ai-summary-content"
     style="white-space: pre-wrap; line-height: 1.8;">
    @aiSummary
</div>


        <small class="text-muted mt-2">
            Nội dung do AI tạo, cần được kỹ thuật viên kiểm tra.
        </small>
    </div>
}


<div class="card p-3 mb-3">
    <h5>Thông tin xe</h5>
    <p><strong>Biển số:</strong> @vehicle?.LicensePlate</p>
    <p><strong>Khách hàng:</strong> @vehicle?.Customer?.FullName</p>
</div>

<div class="card p-3">
    <h5>Danh sách lịch sử sửa chữa</h5>

    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Ngày sửa chữa</th>
                    <th>Tình trạng xe</th>
                    <th>Kỹ thuật viên</th>
                    <th>Ghi chú</th>
                    <th>Trạng thái</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@item.Description</td>
                        <td>@item.TechnicianName</td>
                        <td>@item.RepairNotes</td>
                        <td>@item.Status</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Xe chưa có lịch sử sửa chữa.
        </div>
    }
</div>

<a asp-action="Index"
   class="btn btn-secondary mt-3">
    Quay lại
</a>
