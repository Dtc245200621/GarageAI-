
@model GarageAI.Models.Appointment

@{
    ViewData["Title"] = "Thêm lịch hẹn";
}

<h2>📅 Thêm lịch hẹn sửa chữa</h2>

<div class="card p-4 mt-3">
    <form asp-controller="Appointments"
          asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="All"
             class="text-danger"></div>

        <div class="mb-3">
            <label class="form-label">Chọn xe</label>
            <select asp-for="VehicleId"
                    asp-items="ViewBag.Vehicles"
                    class="form-select">
                <option value="0">-- Chọn xe --</option>
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">Ngày giờ hẹn</label>
            <input asp-for="AppointmentDate"
                   type="datetime-local"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">
                Mô tả tình trạng xe
            </label>
            <textarea asp-for="Description"
                      class="form-control"
                      rows="4"
                      placeholder="Ví dụ: Xe bị rung khi phanh"></textarea>
        </div>

        <button type="submit"
                class="btn btn-primary">
            Lưu lịch hẹn
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Quay lại
        </a>
    </form>
</div>
