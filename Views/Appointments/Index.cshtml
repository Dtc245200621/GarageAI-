
@model List<GarageAI.Models.Appointment>

@{
    ViewData["Title"] = "Quản lý lịch hẹn";
}

<h2>📅 Quản lý lịch hẹn sửa chữa</h2>

<a asp-controller="Appointments"
   asp-action="Create"
   class="btn btn-primary mb-3">
    + Thêm lịch hẹn
</a>


<p class="text-muted">
    Danh sách lịch hẹn sửa chữa ô tô của khách hàng.
</p>

@if (ViewBag.Success != null)
{
    <div class="alert alert-success">
        @ViewBag.Success
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="card p-3 mb-3">
    <h5>Tìm kiếm và lọc lịch hẹn</h5>

    <form asp-controller="Appointments"
          asp-action="Index"
          method="get">

        <div class="row g-2">
            <div class="col-md-4">
                <input type="text"
                       name="search"
                       value="@ViewBag.Search"
                       class="form-control"
                       placeholder="Biển số hoặc tên khách hàng" />
            </div>

            <div class="col-md-3">
                <select name="status"
                        class="form-select">
                    <option value="">Tất cả trạng thái</option>

                    <option value="ChoXacNhan"
                        selected="@(ViewBag.Status == "ChoXacNhan")">
                        Chờ xác nhận
                    </option>

                    <option value="DaXacNhan"
                        selected="@(ViewBag.Status == "DaXacNhan")">
                        Đã xác nhận
                    </option>

                    <option value="DaHuy"
                        selected="@(ViewBag.Status == "DaHuy")">
                        Đã hủy
                    </option>

                    <option value="HoanThanh"
                        selected="@(ViewBag.Status == "HoanThanh")">
                        Hoàn thành
                    </option>
                </select>
            </div>

            <div class="col-md-3">
                <input type="date"
                       name="date"
                       value="@ViewBag.Date"
                       class="form-control" />
            </div>

            <div class="col-md-2">
                <button type="submit"
                        class="btn btn-primary w-100">
                    Tìm kiếm
                </button>
            </div>
        </div>
    </form>

    <a asp-action="Index"
       class="btn btn-outline-secondary mt-2">
        Xóa bộ lọc
    </a>
</div>


<div class="card p-3 mt-3">
    <h5>Danh sách lịch hẹn</h5>

    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Biển số xe</th>
                    <th>Khách hàng</th>
                    <th>Ngày hẹn</th>
                    <th>Mô tả</th>
                    <th>Trạng thái</th>
                    <th>Thao tác</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>

                        <td>
                            @item.Vehicle?.LicensePlate
                        </td>

                        <td>
                            @item.Vehicle?.Customer?.FullName
                        </td>

                        <td>
                            @item.AppointmentDate.ToString("dd/MM/yyyy HH:mm")
                        </td>

                        <td>@item.Description</td>

                        <td>
                            @switch (item.Status)
                            {
                                case "ChoXacNhan":
                                    <span class="badge bg-warning text-dark">
                                        Chờ xác nhận
                                    </span>
                                    break;

                                case "DaXacNhan":
                                    <span class="badge bg-primary">
                                        Đã xác nhận
                                    </span>
                                    break;

                                case "HoanThanh":
                                    <span class="badge bg-success">
                                        Hoàn thành
                                    </span>
                                    break;

                                case "DaHuy":
                                    <span class="badge bg-danger">
                                        Đã hủy
                                    </span>
                                    break;

                                default:
                                    <span class="badge bg-secondary">
                                        @item.Status
                                    </span>
                                    break;
                            }
                        </td>
                        
<td>
    @if (item.Status == "ChoXacNhan" ||
         item.Status == "DaXacNhan")
    {
        <a asp-action="Edit"
           asp-route-id="@item.Id"
           class="btn btn-sm btn-warning mb-1">
            Sửa
        </a>
    }

    @if (item.Status == "ChoXacNhan")
    {
        <form asp-action="Confirm"
              asp-route-id="@item.Id"
              method="post"
              class="d-inline">
            @Html.AntiForgeryToken()

            <button type="submit"
                    class="btn btn-sm btn-success mb-1">
                Xác nhận
            </button>
        </form>
    }

    @if (item.Status == "ChoXacNhan" ||
         item.Status == "DaXacNhan")
    {
        <form asp-action="Cancel"
              asp-route-id="@item.Id"
              method="post"
              class="d-inline"
              onsubmit="return confirm('Bạn có chắc muốn hủy lịch hẹn này?')">
            @Html.AntiForgeryToken()

            <button type="submit"
                    class="btn btn-sm btn-danger mb-1">
                Hủy
            </button>
        </form>
    }
</td>

                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info mt-3">
            Chưa có lịch hẹn sửa chữa nào.
        </div>
    }
</div>
