
@{
    ViewData["Title"] = "AI tóm tắt lịch sử sửa chữa";
}

<h2>🤖 AI tóm tắt lịch sử sửa chữa</h2>

<div class="card p-3 mt-3">
    <h5>Biển số xe: @ViewBag.LicensePlate</h5>

    <h5 class="mt-3">Kết quả tóm tắt từ AI</h5>

    <div class="alert alert-light border"
         style="white-space: pre-wrap;">
        @ViewBag.Result
    </div>

    <div class="alert alert-warning">
        Nội dung AI chỉ mang tính tham khảo.
        Cần kiểm tra thực tế trước khi sửa chữa.
    </div>
</div>

<a asp-controller="RepairOrders"
   asp-action="Index"
   class="btn btn-secondary mt-3">
    Quay lại
</a>
